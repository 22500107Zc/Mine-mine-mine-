###############################################################################
# St.Cloud~OS — environment template
#
# Copy to .env and fill in values. Use ONLY your deployment's secret storage
# for real secrets. Never commit a filled-in .env file.
###############################################################################

# ---------------------------------------------------------------------------
# APPLICATION
# ---------------------------------------------------------------------------
PRODUCT_NAME=St.Cloud~OS
COMPANY_NAME=Culp Industries
PRODUCT_DESCRIPTION=Business Execution Intelligence OS
# Public URL customers use, e.g. https://app.your-domain.example (no trailing slash)
APP_URL=
PUBLIC_APP_URL=
# Optional overrides (derived from APP_URL when empty)
# API_URL is not required: the API is served under APP_URL/api
AUTH_URL=
SUPPORT_EMAIL=
# Optional: governing law clause used in the Terms of Service
LEGAL_GOVERNING_LAW=
ENVIRONMENT=production

# ---------------------------------------------------------------------------
# DATABASE (PostgreSQL only)
# ---------------------------------------------------------------------------
# postgres://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_URL=
# Used by docker-compose.yml for the bundled PostgreSQL container
POSTGRES_DB=culpos
POSTGRES_USER=culpos
POSTGRES_PASSWORD=

# ---------------------------------------------------------------------------
# FOUNDER (platform owner; signs in at /founder with a password only)
# ---------------------------------------------------------------------------
# Set the initial Founder password in your secret store, NOT in this file.
# It is hashed (bcrypt) on first boot; change it afterwards at /founder/account.
FOUNDER_BOOTSTRAP_PASSWORD=

# ---------------------------------------------------------------------------
# STRIPE (one plan: St.Cloud~OS, $333.88 USD / month = 33388 cents)
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=

# ---------------------------------------------------------------------------
# EMAIL
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=St.Cloud~OS

# ---------------------------------------------------------------------------
# SECURITY (generate each with: openssl rand -hex 32)
# ---------------------------------------------------------------------------
# Signs access tokens (JWT)
JWT_SECRET=
# CSRF protection for sign-in pages
CSRF_SECRET=
# Signs St.Cloud~OS checkout/status references
SESSION_SECRET=
# Secure cookies are enabled automatically when APP_URL is https://
